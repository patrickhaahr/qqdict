{
  "name": "qqdict",
  "version": "0.5.3",
  "private": true,
  "description": "Minimal push-to-talk dictation for macOS using your existing Codex sign-in.",
  "productName": "qqdict",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild src/main.ts src/preload.ts src/probe.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --external:ws --outdir=dist",
    "build:native": "zsh native/build.sh",
    "package:mac": "npm run build:native && npm run build && node scripts/package-macos.mjs",
    "start": "npm run build:native && npm run build && electron .",
    "probe": "npm run build && node dist/probe.js",
    "test": "node --import tsx --test src/*.test.ts && node --test scripts/*.test.mjs",
    "dist:mac": "npm run package:mac && node scripts/create-dmg.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "appdmg": "0.6.6",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "license": "MIT",
  "homepage": "https://github.com/qwertyu-alex/qqdict",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwertyu-alex/qqdict.git"
  },
  "bugs": {
    "url": "https://github.com/qwertyu-alex/qqdict/issues"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "appdmg": {
      "image-size": "2.0.3"
    }
  }
}
