{
  "name": "qqdict",
  "version": "0.5.6",
  "private": true,
  "description": "Minimal push-to-talk dictation for macOS and Linux using your existing Codex sign-in.",
  "productName": "qqdict",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build && node scripts/build-main.mjs",
    "build:icon": "node scripts/generate-app-icon.mjs",
    "build:native": "node scripts/build-native.mjs",
    "package:mac": "pnpm run build:native && pnpm run build && node scripts/package-macos.mjs",
    "start": "pnpm run build:native && pnpm run build && electron .",
    "probe": "pnpm run build && node dist/probe.js",
    "test": "node --import tsx --test src/*.test.ts && node --test scripts/*.test.mjs",
    "dist:mac": "pnpm run package:mac && node scripts/create-dmg.mjs",
    "postinstall": "node scripts/install-electron.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "optionalDependencies": {
    "appdmg": "0.6.6"
  },
  "license": "MIT",
  "homepage": "https://github.com/qwertyu-alex/qqdict",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwertyu-alex/qqdict.git"
  },
  "bugs": {
    "url": "https://github.com/qwertyu-alex/qqdict/issues"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.9.0"
}
